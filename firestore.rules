rules_version = '2';

// The task bank is shared: every logged-in teacher can see and use all tasks, and teachers with a
// verified e-mail can add tasks. Only the teacher who saved a task can change or delete it.
// Saved sets, progression and the old private bank stay private under /users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validTask(t) {
      return t.keys().hasAll(['title', 'intro', 'parts', 'grade', 'area', 'topic', 'difficulty'])
        && t.title is string && t.title.size() > 0 && t.title.size() <= 120
        && t.grade is int && t.grade >= 1 && t.grade <= 9
        && t.area in ['Tal og regnestrategier', 'Algebra', 'Geometri og måling', 'Statistik og sandsynlighed']
        && t.difficulty in ['Let', 'Middel', 'Svær']
        && t.parts is list && t.parts.size() >= 1 && t.parts.size() <= 6;
    }

    // Keep in sync with ADMIN_EMAILS in src/shared/admin.ts
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['simonberthelsen@hotmail.com'];
    }

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if verified()
        && request.resource.data.ownerUid == request.auth.uid
        && validTask(request.resource.data);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validTask(request.resource.data);
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // One profile per teacher (written by the teacher at login), readable by the teacher and admins.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
    }

    // Login log: a teacher can add their own entries; only admins can read it. Never changed.
    match /logins/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'device']);
      allow read: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // version 1's private bank: only read and delete (the app moves it to /tasks on login)
      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
      }

      // Saved sets are snapshots: the tasks inside can never change after creation.
      match /sets/{setId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.tasks is list
          && request.resource.data.tasks.size() >= 1
          && request.resource.data.tasks.size() <= 60;
        allow update: if isOwner(uid)
          && request.resource.data.tasks == resource.data.tasks
          && request.resource.data.totalPoints == resource.data.totalPoints;
      }

      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
