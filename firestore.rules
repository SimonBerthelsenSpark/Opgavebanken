rules_version = '2';

// The task bank is shared: every logged-in teacher can see and use all tasks, and teachers with a
// verified e-mail can add tasks. Only the teacher who saved a task can change or delete it.
// Saved sets, progression and the old private bank stay private under /users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validTask(t) {
      return t.keys().hasAll(['title', 'intro', 'parts', 'grade', 'area', 'topic', 'difficulty'])
        && t.title is string && t.title.size() > 0 && t.title.size() <= 120
        && t.grade is int && t.grade >= 1 && t.grade <= 12
        && t.area in ['Tal og regnestrategier', 'Algebra', 'Geometri og måling', 'Statistik og sandsynlighed', 'Funktioner og infinitesimalregning']
        && t.difficulty in ['Let', 'Middel', 'Svær']
        && t.parts is list && t.parts.size() >= 1 && t.parts.size() <= 6;
    }

    // Keep in sync with ADMIN_EMAILS in src/shared/admin.ts
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['simonberthelsen@hotmail.com'];
    }

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if verified()
        && request.resource.data.ownerUid == request.auth.uid
        && validTask(request.resource.data);
      allow update: if request.auth != null
        && ((resource.data.ownerUid == request.auth.uid
             && request.resource.data.ownerUid == resource.data.ownerUid
             && validTask(request.resource.data))
          // anyone may count one more use when a set with the task is saved
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
             && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1));
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // One profile per teacher (written by the teacher at login). Every teacher can see the admin overview.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
    }

    // Login log: a teacher can add their own entries; every teacher can read it. Never changed.
    match /logins/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'at', 'device']);
      allow read: if request.auth != null;
    }

    // Error reports on tasks: any teacher can report; the task owner, the reporter and admins can
    // mark a report resolved (only the status fields may change); admins can delete reports.
    match /reports/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;
      allow update: if request.auth != null
        && (isAdmin() || resource.data.ownerUid == request.auth.uid || resource.data.reporterUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status == 'resolved';
      allow delete: if isAdmin();
    }

    // Digital student sets: anyone with the link can open one (no listing), without answers.
    // Only the teacher who shared it can change or remove it.
    match /shared/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.tasks is list
        && request.resource.data.tasks.size() <= 60;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // version 1's private bank: only read and delete (the app moves it to /tasks on login)
      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid);
      }

      // Saved sets are snapshots: the tasks inside can never change after creation.
      match /sets/{setId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.tasks is list
          && request.resource.data.tasks.size() >= 1
          && request.resource.data.tasks.size() <= 60;
        allow update: if isOwner(uid)
          && request.resource.data.tasks == resource.data.tasks
          && request.resource.data.totalPoints == resource.data.totalPoints;
      }

      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Favourites and own collections of tasks
      match /collections/{colId} {
        allow read, write: if isOwner(uid);
      }

      // The class's points per saved set (students by number or initials)
      match /results/{setId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
