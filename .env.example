# Copy to .env for local development. Never commit .env.
# Firebase web config (public values, from Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server (Netlify Functions)
FIREBASE_PROJECT_ID=
# OPENAI_API_KEY is set as a secret in Netlify, or pulled locally with `netlify env:list`/`netlify dev`.
# Do not write it in this file if the repo is shared.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
# Comma-separated e-mails allowed to generate with AI (empty = every logged-in teacher)
ALLOWED_EMAILS=
AI_CALLS_PER_HOUR=60

# Local development against the Firebase emulators and the test AI (no costs):
# VITE_USE_EMULATORS=1
# AUTH_EMULATOR=1
# MOCK_AI=1
